# Keeps gunicorn running: starts on boot, restarts automatically if it ever crashes.
#
# Install (as root / with sudo):
#   cp deploy/systemd/ilmildizi.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ilmildizi
#
# Check status / logs:
#   systemctl status ilmildizi
#   journalctl -u ilmildizi -f
#
# Adjust the three paths below (User, WorkingDirectory, ExecStart) to match your server —
# they assume the project lives at /srv/ilmildizi and the venv at /srv/ilmildizi/venv,
# owned by a dedicated non-root user (also called ilmildizi here; create with
# `adduser --system --group ilmildizi` if it doesn't exist yet).

[Unit]
Description=IlmIldizi (gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service

[Service]
Type=simple
User=ilmildizi
Group=ilmildizi
WorkingDirectory=/srv/ilmildizi
EnvironmentFile=/srv/ilmildizi/.env
# Bind to localhost only — Nginx (deploy/nginx/ilmildizi.conf) is the only thing that
# should be reachable from the internet; gunicorn itself never is.
Environment=GUNICORN_BIND=127.0.0.1:8000
ExecStart=/srv/ilmildizi/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Hardening: the service can't write anywhere except what it actually needs to.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/srv/ilmildizi/media /srv/ilmildizi/staticfiles /srv/ilmildizi/backups

[Install]
WantedBy=multi-user.target
