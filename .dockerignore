# Version control / IDE
.git
.gitignore
.vscode
.idea

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node (only used at build time on the host to compile Tailwind; not needed in the image)
node_modules/

